<application xmlns="https://jakarta.ee/xml/ns/jakartaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/application_10.xsd" version="10">
    <display-name>servlet_resourcedefs</display-name>
    <!-- The EJBLite web vehicle client derives the request URL from the
         deployment archive base name (vehicle_archive_name), so the war's
         context-root must match the ear's base name. -->
    <module>
        <connector>whitebox-rd.rar</connector>
    </module>
    <module>
        <web>
            <web-uri>servlet_resourcedefs_web.war</web-uri>
            <context-root>servlet_resourcedefs</context-root>
        </web>
    </module>
</application>
